.env
node_modules/
.DS_Store

# Agent setup in .claude/ is tracked; only local-machine files are ignored.
.claude/settings.local.json
.claude/launch.json

# The retired results Worker now lives in archive/helltrack-results/ (not deployed — see the
# README in that folder). Its source IS tracked; its own .gitignore covers node_modules etc.
# These two are belt-and-braces for Worker secret files anywhere in the tree.
.dev.vars*
.wrangler/

# Historical backfill intermediates — regenerable, not committed.
# data/raw/    = cached raw UCI DataRide JSON (re-fetched if absent)
# data/staging = per-season normalized output before merge into public/results.json
data/
